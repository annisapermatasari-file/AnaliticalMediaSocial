# === NextAuth ===
# Generate secret dengan: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL dasar aplikasi (wajib diisi di production, mis. https://asetdigital.vercel.app)
NEXTAUTH_URL=http://localhost:3210

# === Google OAuth ===
# Buat di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
